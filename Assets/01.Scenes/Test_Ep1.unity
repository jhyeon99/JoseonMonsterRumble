  _highJumpMessage: "\uAE38\uAC8C \uB20C\uB7EC \uB354 \uB192\uC774 \uC810\uD504"
  _respawnMessage: "\uC7A5\uC2B9\uC5D0 \uB2E4\uAC00\uAC00\uBA74 \uB9AC\uC2A4\uD3F0
    \uD3EC\uC778\uD2B8\uAC00 \uD65C\uC131\uD654\uB429\uB2C8\uB2E4."
  _parryMessage: "\uBC18\uC9DD\uC774\uB294 \uACF5\uACA9\uC744 \uD328\uB9C1\uD558\uBA74\n\uC801\uC744
    \uADF8\uB85C\uAE30 \uC0C1\uD0DC\uB85C \uB9CC\uB4E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
