  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 36ad9c339409441cba5ed29249ea207f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Ep1TutorialManager
  _enableCheckpointCinematic: 1
  _checkpointRevealDelay: 0.15
  _checkpointZoomFactor: 0.45
  _checkpointZoomDuration: 0.7
  _checkpointReturnDuration: 0.5
  _checkpointLetterboxAmount: 0.08
  _guardHintPoint: {fileID: 990213034}
  _guardGaugeFocus: {fileID: 1257574901}
  _soulGaugeFocus: {fileID: 1085565927}
  _guardKeySprite: {fileID: 21300004, guid: 8ce7e7c466d746ed81978a9de9c5f59d, type: 3}
  _continueKeySprite: {fileID: 21300008, guid: 8ce7e7c466d746ed81978a9de9c5f59d, type: 3}
  _guardHoldMessage: "\uD0A4\uB97C \uAE38\uAC8C \uB20C\uB7EC \uAC00\uB4DC"
  _guardGaugeMessage: "\uAC00\uB4DC\uB97C \uC0AC\uC6A9\uD558\uBA74 \uAC8C\uC774\uC9C0\uAC00
    \uB2F3\uC2B5\uB2C8\uB2E4.\n\uAC8C\uC774\uC9C0\uB97C \uB2E4 \uC0AC\uC6A9\uD558\uBA74,\n\uAC00\uB4DC\uB97C
    \uD574\uB3C4 \uB370\uBBF8\uC9C0\uB97C \uC785\uC2B5\uB2C8\uB2E4."
  _soulDropMessage: "\uC694\uAD34 \uCC98\uCE58 \uC2DC, \uC601\uD63C\uC744 \uC2B5\uB4DD\uD569\uB2C8\uB2E4."
  _soulGaugeMessage: "\uC2B5\uB4DD\uD55C \uC601\uD63C\uC740 \uC774\uACF3\uC5D0\uC11C
    \uD655\uC778 \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  _continueMessage: "Enter\uB97C \uB20C\uB7EC \uACC4\uC18D"
  _parryEncounterDistance: 8
  _enterDelay: 0.2
  _dimOpacity: 0.65
  _popupFontSize: 30
  _popupFontStyle: 0
  _popupTextColor: {r: 0.96, g: 0.94, b: 0.87, a: 1}
  _popupOutlineColor: {r: 0, g: 0, b: 0, a: 1}
  _popupOutlineThickness: 1
  _focusBorderColor: {r: 0.75, g: 0.85, b: 1, a: 1}
  _focusPadding: 8
  _popupTextSize: {x: 650, y: 170}
  _soulFocusDelay: 0.25
  _soulFocusPadding: 32
  _soulFocusMinimumSize: {x: 240, y: 180}
  _guardExplanationMessage: "\uC544\uB798 \uBC29\uD5A5\uD0A4\uB97C \uB204\uB974\uACE0
    \uC788\uC73C\uBA74 \uAC00\uB4DC\uD569\uB2C8\uB2E4.\n\uAC00\uB4DC\uB85C \uC694\uAD34\uC758
    \uACF5\uACA9\uC744 \uB9C9\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  _parryFinisherMessage: "\uD328\uB9C1\uC5D0 \uC131\uACF5\uD55C \uBAAC\uC2A4\uD130\uB294
    \uB178\uB797\uAC8C \uBC18\uC9DD\uC785\uB2C8\uB2E4.\nX\uB97C \uB20C\uB7EC \uB9C8\uBB34\uB9AC
    \uACF5\uACA9\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  _parryZoomFactor: 0.45
  _parryZoomDuration: 0.5
  _parryReturnDuration: 0.4
  _parryLetterboxAmount: 0.08
  _requirePracticeInput: 1
  _enableTalismanTutorial: 1
  _talismanPrerequisiteEnemies:
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  _talismanTarget: {fileID: 0}
  _hideTalismanTargetUntilPrerequisites: 1
  _talismanKeySprite: {fileID: 0}
  _talismanIntroMessage: "V\uD0A4\uB97C \uB20C\uB7EC \uBD80\uC801\uC744 \uB0A0\uB9B4
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC9E7\uAC8C \uB20C\uB800\uB2E4\uAC00 \uB5BC\uBA74
    \uBD80\uC801 \uD55C \uC7A5\uC774 \uBC1C\uC0AC\uB429\uB2C8\uB2E4."
  _talismanTapMessage: "V\uD0A4\uB97C \uC9E7\uAC8C \uB20C\uB7EC\n\uB2E8\uBC1C \uACF5\uACA9"
  _talismanChargeExplanation: "V\uD0A4\uB97C \uAE38\uAC8C \uB204\uB974\uBA74 \uBD80\uC801\uC774
    \uCDA9\uC804\uB429\uB2C8\uB2E4.\n\uD0A4\uB97C \uB5BC\uBA74 \uCDA9\uC804\uD55C
    \uBD80\uC801\uC744 \uD55C\uAEBC\uBC88\uC5D0 \uB0A0\uB9BD\uB2C8\uB2E4.\n\uBD80\uC801
    \uD55C \uC7A5\uB9C8\uB2E4 \uC601\uD63C\uC744 \uC18C\uBAA8\uD569\uB2C8\uB2E4."
  _talismanChargeMessage: "V\uD0A4\uB97C \uAE38\uAC8C \uB20C\uB7EC\n\uC5F0\uBC1C
    \uACF5\uACA9"
  _talismanVisibleDelay: 0.2
  _talismanMinimumSouls: 3
  _talismanZoomFactor: 0.45
  _talismanZoomDuration: 0.7
  _talismanReturnDuration: 0.5
  _talismanLetterboxAmount: 0.08
  _talismanShotPauseDelay: 0.35
  _refillTalismanPracticeSouls: 1
  _highJumpHintPoint: {fileID: 237235182}
  _respawnHintPoint: {fileID: 844187678}
  _parryHintPoint: {fileID: 583985262}
  _followHintTargets: 1
